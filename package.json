{
  "name": "vue-spring-boot-fullstack",
  "version": "1.0.0",
  "description": "Full-stack application with Vue 3 frontend and Spring Boot backend",
  "scripts": {
    "frontend": "cd src/frontend && npm run dev",
    "backend": "cd src/backend/vue-spring-boot-backend && mvn spring-boot:run",
    "dev": "concurrently \"npm:frontend\" \"npm:backend\"",
    "install-frontend": "cd src/frontend && npm install",
    "install-backend": "cd src/backend/vue-spring-boot-backend && mvn clean install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["vue", "spring-boot", "fullstack", "java", "javascript"],
  "author": "Toshifumi Kurosawa",
  "license": "MIT"
}
